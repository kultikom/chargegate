# Copy to .env and adjust

SECRET_KEY=change-me-to-a-long-random-string   # e.g. openssl rand -hex 32
TIMEZONE=Europe/Berlin
LANGUAGE_UI=auto                               # auto | en | de

REQUIRE_STATION_APPROVAL=true
LOCAL_LIST_ENABLED=true
APPLY_STATION_CONFIG=true
HEARTBEAT_INTERVAL=300
LOG_OCPP_MESSAGES=false

METER_VALUE_INTERVAL=60
# OCPP address shown in the UI (optional)
#PUBLIC_OCPP_URL=ws://192.168.1.10:9000/ocpp/

# Home Assistant via MQTT discovery (optional)
#MQTT_ENABLED=true
#MQTT_HOST=homeassistant.local
#MQTT_USERNAME=
#MQTT_PASSWORD=
#HA_EMPLOYEE_DISPLAY=name     # name | initials | hidden

# Local admin login (used while Entra login is not configured; empty = disabled)
ADMIN_PASSWORD=change-me

# Optional: PostgreSQL instead of SQLite
#DATABASE_URL=postgresql+asyncpg://chargegate:password@db:5432/chargegate

# --- Microsoft Entra ID (optional) -------------------------------------------------
#ENTRA_TENANT_ID=
#ENTRA_CLIENT_ID=
#ENTRA_CLIENT_SECRET=
# Admin login via Microsoft (needs HTTPS and this redirect URI in the app registration)
#ENTRA_REDIRECT_URI=https://charge.example.com/auth/callback
#ADMIN_EMAILS=admin@example.com
#ADMIN_GROUP_ID=
# Employee sync
#ENTRA_SYNC_GROUP_ID=
#ENTRA_RFID_ATTRIBUTE=extensionAttribute10
#ENTRA_SYNC_INTERVAL_MIN=60
